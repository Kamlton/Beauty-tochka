<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beauty_tochka</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Beauty_tochka.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3"
             style="background-color:#2F1C1B;">
            <div class="container-fluid flex-column text-center">

                <!-- 1 строка: название -->
                <a class="navbar-brand mb-1"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   style="font-size: 2rem; color:white; font-weight:600; transition: color 0.2s;">
                    Beauty&tochka
                </a>

                <!-- 2 строка: описание -->
                <div class="mb-2" style="color:#BAAC9D; font-size:1.1rem; transition: color 0.2s;">
                    Салон красоты премиум-класса
                </div>

                <!-- 3 строка: меню -->
                <button class="navbar-toggler mb-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Services">Услуги</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Masters">Мастера</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Reviews">Отзывы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="recordForm">Запись</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Contacts">Контакты</a>
                        </li>
                        <li class="nav-item" id="nav-login">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Login">Вход</a>
                        </li>
                        <li class="nav-item" id="nav-register">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Register">Регистрация</a>
                        </li>
                        <li class="nav-item d-none" id="nav-user">
                            <span class="nav-link nav-link-custom" style="cursor:pointer;" onclick="logout()">
                                Выход (<span id="user-name"></span>)
                            </span>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <style>
        /* Общий стиль для ссылок меню */
        .nav-link-custom {
            color: #BAAC9D;
            font-size: 1.15rem; /* немного больше обычного */
            font-weight: 500;
            transition: color 0.2s, transform 0.2s;
        }

            .nav-link-custom:hover {
                color: #FFFFFF;
                transform: scale(1.05); /* небольшое увеличение при наведении */
            }

        /* Меню-тогглер для мобильных */
        .navbar-toggler {
            border-color: #BAAC9D;
        }

        .navbar-toggler-icon {
            filter: invert(0.7); /* делает иконку более видимой на темном фоне */
        }
    </style>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom text-center py-4">
        <div class="container">

            <p class="mb-2" style="color:#BAAC9D; font-weight:500;">Связаться с нами</p>
            <p class="mb-3" style="color:#BAAC9D; font-weight:500;">+7 (999) 123-45-67</p>

            <div class="d-flex justify-content-center gap-3">
                <button class="footer-btn">WhatsApp</button>
                <button class="footer-btn">Telegram</button>
                <button class="footer-btn">VK</button>
            </div>

        </div>
    </footer>

    <style>
        /* Футер всегда внизу */
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1; /* основной контент растягивается */
        }

        .footer-custom {
            background-color: #2F1C1B;
            color: #BAAC9D;
            flex-shrink: 0;
        }

        /* Кнопки футера, как карточки */
        .footer-btn {
            background-color: #F8F5F0; /* светлый фон */
            color: #000;
            border: none;
            border-radius: 20px;
            padding: 12px 28px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease-in-out;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

            .footer-btn:hover {
                background-color: #693027; /* темный при наведении */
                color: #fff; /* текст белый */
                box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const API_URL = '@(ViewBag.ApiUrl ?? "http://localhost:5003")';

        function getToken() {
            return localStorage.getItem('jwt_token');
        }

        function setToken(token) {
            localStorage.setItem('jwt_token', token);
        }

        function removeToken() {
            localStorage.removeItem('jwt_token');
        }

        function logout() {
            removeToken();
            window.location.href = '/';
        }

        async function loadUser() {
            const token = getToken();
            if (!token) return;
            try {
                const res = await fetch(`${API_URL}/api/auth/me`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    const user = await res.json();
                    document.getElementById('user-name').textContent = user.fullName;
                    document.getElementById('nav-login').classList.add('d-none');
                    document.getElementById('nav-register').classList.add('d-none');
                    document.getElementById('nav-user').classList.remove('d-none');
                } else {
                    removeToken();
                }
            } catch {
                removeToken();
            }
        }

        loadUser();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
